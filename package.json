{
  "name": "dsh-glm-usage",
  "displayName": "DSH GLM Usage",
  "description": "在 DeepSeek Harness 侧栏展示智谱 GLM Coding Plan 的用量（5 小时窗口 / 每周窗口 / MCP 工具额度）— Zhipu GLM Coding Plan usage in the DSH sidebar.",
  "version": "0.1.0",
  "author": "zhangaiyu1996",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "zhipu",
    "bigmodel",
    "glm",
    "coding-plan",
    "usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangaiyu1996/dsh-glm-usage.git"
  },
  "homepage": "https://github.com/zhangaiyu1996/dsh-glm-usage#readme",
  "bugs": {
    "url": "https://github.com/zhangaiyu1996/dsh-glm-usage/issues"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs",
    "test:host": "node test/host.test.mjs",
    "test:client": "node test/client.test.mjs"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0"
  },
  "icon": "./assets/icon.svg"
}
